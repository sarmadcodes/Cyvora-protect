{
  "expo": {
    "name": "Cyvora Protect",
    "slug": "cybershield",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.deskworksolutions.cybershield"
    },
    "android": {
      "package": "com.deskworksolutions.cybershield",
      "permissions": ["READ_PHONE_STATE"],
      "usesCleartextTraffic": true
    },
    "backgroundColor": "#010810",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e7d9843d-0b43-4d85-b1bb-2397b042b2c8"
      }
    }
  }
}