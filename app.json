{
  "expo": {
    "name": "Cyvora Protect",
    "slug": "cybershield",
    "version": "1.0.3",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/AppIcon-1024.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cyvoraprotect.app",
      "buildNumber": "7",
      "icon": "./assets/images/AppIcon-1024.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Cyvora Protect",
        "CFBundleName": "Cyvora Protect",
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "168.231.126.16": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "package": "com.deskworksolutions.cybershield",
      "versionCode": 7,
      "icon": "./assets/images/AppIcon-1024.png",
      "permissions": [
        "READ_PHONE_STATE"
      ],
      "usesCleartextTraffic": true
    },
    "backgroundColor": "#010810",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e7d9843d-0b43-4d85-b1bb-2397b042b2c8"
      }
    }
  }
}